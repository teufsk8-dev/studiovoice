# --- Chain -------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
POLL_INTERVAL_SEC=2
# Block to start scanning from. Empty = latest block minus LOOKBACK_BLOCKS.
START_BLOCK=
LOOKBACK_BLOCKS=0
MAX_BLOCK_RANGE=2000

# --- Quote token & USD pricing ---------------------------------------------------
# Token that new memecoins are paired against (normally WETH). REQUIRED:
# pools not paired with it are skipped, and liquidity_usd is measured on it.
QUOTE_TOKEN=
# USD price of the quote token: either a fixed value (use 1 for a stablecoin)...
QUOTE_USD_PRICE=
# ...or a Uniswap V3 pool QUOTE_TOKEN/<stablecoin> read live (takes precedence).
QUOTE_USD_POOL=

# --- Decision engine -------------------------------------------------------------
# jev = src/memebot/decision_engine.py (needs TYPESAFE_API_KEY); stub = always "hold"
DECISION_ENGINE=stub
TYPESAFE_API_KEY=
DECISION_TIMEOUT_SEC=2.0
# How long a new pool is watched while it has no / too little liquidity.
WATCH_WINDOW_SEC=600

# --- Hard gates (applied in code, after the decision engine) ---------------------
MIN_LIQUIDITY_USD=20000
MIN_CONFIDENCE=0.70
MAX_RISK_SCORE=4
REQUIRE_OWNER_RENOUNCED=true

# --- Executor --------------------------------------------------------------------
# Real transactions are sent ONLY if this is exactly "true".
LIVE_MODE=false
PRIVATE_KEY=
QUOTER_V2_ADDRESS=
SWAP_ROUTER02_ADDRESS=
# Pay with native ETH (router wraps it). Requires QUOTE_TOKEN == router.WETH9().
PAY_WITH_NATIVE=true
# Amount spent per buy, in QUOTE_TOKEN units (e.g. 0.01 WETH).
TRADE_SIZE_QUOTE=0.01
MAX_PRICE_IMPACT=0.03
# amountOutMinimum = simulated amountOut * (1 - MAX_SLIPPAGE)
MAX_SLIPPAGE=0.01
MAX_OPEN_POSITIONS=3
MAX_SESSION_SPEND_QUOTE=0.05
TX_DEADLINE_SEC=60
TX_TIMEOUT_SEC=120

# --- Output ----------------------------------------------------------------------
DECISIONS_LOG=data/decisions.jsonl
LEDGER_LOG=data/ledger.jsonl
